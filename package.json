{
  "name": "nuslink",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "build:android:apk": "npx --yes eas-cli build --platform android --profile preview",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:mobile": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:backend": "pytest backend/tests/ -q",
    "test": "npm run test:mobile && npm run test:backend"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@supabase/supabase-js": "^2.106.1",
    "expo": "~56.0.3",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.14",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.5",
    "expo-image-picker": "^56.0.13",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-router": "~56.2.5",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~56.0.9",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "nativewind": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "^3.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^8.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
