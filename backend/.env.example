SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
ALLOWED_ORIGINS=["http://localhost:8081","exp://localhost:8081"]
OPENAI_API_KEY=<server-only-openai-api-key>
OPENAI_MODEL=gpt-5-mini
OPENAI_PROFILE_EXTRACTION_MODEL=gpt-5-mini
EXPO_PUSH_ACCESS_TOKEN=
PUSH_WORKER_ENABLED=true
PUSH_WORKER_INTERVAL_SECONDS=10
GEMINI_API_KEY=<server-only-gemini-api-key>
GEMINI_GROUP_DRAFTING_MODEL=gemini-3.5-flash
GEMINI_MODERATION_MODEL=gemini-3.5-flash
